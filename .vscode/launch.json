{
  // F5 runs Android on the emulator, booting it first if needed.
  //
  // Note that VS Code remembers the *last used* configuration per workspace, so
  // F5 does not necessarily run the first one listed here. If F5 ever launches
  // the wrong thing, pick "Brain Workout (Android)" once in the Run and Debug
  // dropdown and it sticks. There is deliberately no desktop config: this is an
  // Android app, and a stale remembered selection pointing at Windows is exactly
  // how F5 ended up building a Windows app.
  "version": "0.2.0",
  "configurations": [
    {
      // The preLaunchTask boots pixel_api35 and waits for sys.boot_completed
      // (the extension would only wait for it to *connect*), so by launch time
      // the device exists and `deviceId` pins it exactly. Don't add
      // `emulatorId` back alongside it: that starts the emulator a second time
      // on a cold F5, and the second one exits with "device not found".
      //
      // `deviceId: "android"` does NOT work, despite reading sensibly: deviceId
      // is matched against device ids and names, and a booted AVD is
      // "emulator-5554" / "sdk gphone64...", neither of which contains "android".
      "name": "Brain Workout (Android)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "emulator-5554",
      "preLaunchTask": "Boot Android emulator",
      // Impeller renders a blank screen on this x86_64 emulator: the app starts,
      // the VM service connects, logcat reports "Fully drawn" and no Dart error,
      // but FlutterRenderer logs "Width is zero" and nothing is painted (with
      // "HWUI: Failed to initialize 101010-2 format" alongside). Skia works.
      // This is emulator-only — don't carry it into a release build.
      "toolArgs": ["--no-enable-impeller"]
    },
    {
      // Release-ish timings; no hot reload in profile mode.
      "name": "Brain Workout (Android, profile mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "emulatorId": "pixel_api35",
      "flutterMode": "profile",
      "deviceId": "emulator-5554",
      "preLaunchTask": "Boot Android emulator",
      "toolArgs": ["--no-enable-impeller"]
    },
    {
      // Escape hatch: no device pinned, so VS Code asks. Use this for a physical
      // phone over USB, or a quick web check.
      "name": "Brain Workout (pick device)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    }
  ]
}
