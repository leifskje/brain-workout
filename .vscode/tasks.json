{
  "version": "2.0.0",
  "tasks": [
    {
      // Default build task (Ctrl+Shift+B) and the preLaunchTask for the Android
      // debug configs. Exits immediately if an emulator is already attached.
      "label": "Boot Android emulator",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tool/boot_emulator.ps1"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true }
    },
    {
      // Run this when the debugger hangs or a launch never loads. Stopping a
      // hung session in VS Code does not always kill the `flutter run` tree, and
      // the orphan holds the VM service port so the next F5 cannot start.
      "label": "Reset debug session",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tool/reset_debug.ps1"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Analyze",
      "type": "shell",
      "command": "flutter analyze",
      "problemMatcher": ["$dart-analyze"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "flutter test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Regenerate localizations (gen-l10n)",
      "type": "shell",
      "command": "flutter gen-l10n",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    }
  ]
}
